{
    "name": "manhunt",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "start": "node scripts/dev.mjs",
        "dev:ui": "vite --host 127.0.0.1",
        "build": "tsc --noEmit && vite build",
        "db:migrate": "wrangler d1 migrations apply DB --local",
        "reset": "node scripts/database/reset.mjs",
        "reset:local": "node scripts/database/reset.mjs local",
        "reset:remote": "node scripts/database/reset.mjs remote",
        "email:check": "tsx scripts/notifications/email.ts check",
        "email:test": "tsx scripts/notifications/email.ts test",
        "gmail:setup": "tsx scripts/notifications/gmail-setup.ts",
        "push:setup": "tsx scripts/notifications/push-setup.ts",
        "test": "tsx --test \"tests/**/*.test.ts\"",
        "test:integration": "node tests/integrations/workflow.mjs",
        "test:auth": "node tests/integrations/auth.mjs",
        "test:features": "node tests/integrations/features.mjs",
        "test:uploads": "tsx tests/integrations/uploads.mjs",
        "test:uploads:large": "tsx tests/integrations/uploads.mjs --large"
    },
    "dependencies": {
        "exifr": "^7.1.3",
        "file-type": "latest",
        "jose": "^6.2.13",
        "qrcode": "^1.5.4",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "latest",
        "@types/node": "latest",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "latest",
        "tsx": "latest",
        "typescript": "latest",
        "vite": "latest",
        "wrangler": "latest"
    },
    "overrides": {
        "undici": "^7.30.1"
    }
}
